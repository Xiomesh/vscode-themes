    "sideBar.border": "#2C323B",
    "sideBarTitle.foreground": "#F0F1F1",
    "sideBarSectionHeader.background": "#20252C",
    "sideBarSectionHeader.foreground": "#DDE3ED",
    "sideBarSectionHeader.border": "#2C323B",
    "statusBar.background": "#004A9E",
    "statusBar.foreground": "#FFFFFF",
    "statusBar.border": "#006EEB",
    "statusBar.noFolderBackground": "#004A9E",
    "statusBar.noFolderForeground": "#FFFFFF",
    "statusBar.noFolderBorder": "#006EEB",
    "statusBarItem.hoverBackground": "#0059C7",
    "statusBarItem.remoteBackground": "#2F3131",
    "statusBarItem.remoteForeground": "#F0F1F1",
    "statusBar.debuggingBackground": "#8B2E27",
    "statusBar.debuggingForeground": "#FFFFFF",
    "editor.background": "#15181D",
    "editor.foreground": "#F0F1F1",
    "editorLineNumber.foreground": "#606873",
    "editorLineNumber.activeForeground": "#AEC6FF",
    "editorCursor.foreground": "#6EA8FF",
    "editor.selectionBackground": "#006EEB55",
    "editor.inactiveSelectionBackground": "#00439544",
    "editor.selectionHighlightBackground": "#006EEB33",
    "editor.wordHighlightBackground": "#41475455",
    "editor.wordHighlightStrongBackground": "#005AC355",
    "editor.lineHighlightBackground": "#FFFFFF08",
    "editorWhitespace.foreground": "#3C424B",
    "editorIndentGuide.background1": "#2A2F37",
    "editorIndentGuide.activeBackground1": "#727786",
    "editorBracketMatch.background": "#006EEB33",
    "editorBracketMatch.border": "#6EA8FF",
    "editorGutter.background": "#15181D",
