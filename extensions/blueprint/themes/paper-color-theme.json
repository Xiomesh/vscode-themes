    "gitDecoration.modifiedResourceForeground": "#0059C7",
    "gitDecoration.deletedResourceForeground": "#B42318",
    "gitDecoration.untrackedResourceForeground": "#007A86",
    "gitDecoration.ignoredResourceForeground": "#8A9099",
    "gitDecoration.conflictingResourceForeground": "#8A5A00"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#6E747D",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "string.template"],
      "settings": {
        "foreground": "#0F6B5A"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": ["constant.numeric", "constant.language", "constant.character"],
      "settings": {
        "foreground": "#6B4FA3"
      }
    },
    {
      "name": "Keywords and storage",
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": {
        "foreground": "#0059C7"
      }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.enum",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#004395"
      }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "entity.name.method",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#003F88"
      }
    },
    {
      "name": "Variables and parameters",
      "scope": ["variable", "variable.parameter", "entity.name.variable"],
      "settings": {
        "foreground": "#15181D"
      }
    },
    {
      "name": "Punctuation and delimiters",
      "scope": ["punctuation", "meta.brace", "meta.delimiter"],
      "settings": {
        "foreground": "#606369"
      }
    },
    {
      "name": "Tags and components",
      "scope": ["entity.name.tag", "support.class.component"],
      "settings": {
        "foreground": "#0059C7"
      }
    },
    {
      "name": "Attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#0F6B5A"
      }
    },
    {
      "name": "Markdown headings and bold",
      "scope": ["markup.heading", "markup.bold"],
      "settings": {
        "foreground": "#004395",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": ["markup.italic"],
      "settings": {
        "foreground": "#44474D",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Inline and fenced code",
      "scope": ["markup.inline.raw", "markup.fenced_code.block"],
      "settings": {
        "foreground": "#0F6B5A"
      }
    },
    {
      "name": "Invalid syntax",
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#B42318",
        "fontStyle": "underline"
      }
    }
  ],
  "semanticTokenColors": {
    "comment": "#6E747D",
    "string": "#0F6B5A",
    "number": "#6B4FA3",
    "keyword": "#0059C7",
    "operator": "#606369",
    "type": "#004395",
    "class": "#004395",
    "interface": "#004395",
    "struct": "#004395",
    "enum": "#6B4FA3",
    "enumMember": "#6B4FA3",
    "function": "#003F88",
    "method": "#003F88",
    "property": "#414754",
    "variable": "#15181D",
    "parameter": "#44474D",
    "namespace": "#0F6B5A",
    "decorator": "#007A86",
    "regexp": "#7C3FA3"
  }
}
