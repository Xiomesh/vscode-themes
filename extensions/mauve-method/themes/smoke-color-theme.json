    "sideBarSectionHeader.border": "#4B4F55",
    "statusBar.background": "#292D32",
    "statusBar.foreground": "#FFFDFC",
    "statusBar.border": "#D187A5",
    "statusBar.noFolderBackground": "#292D32",
    "statusBar.noFolderForeground": "#FFFDFC",
    "statusBar.noFolderBorder": "#D187A5",
    "statusBarItem.hoverBackground": "#83425D",
    "statusBarItem.remoteBackground": "#D187A5",
    "statusBarItem.remoteForeground": "#292D32",
    "statusBar.debuggingBackground": "#DF656D",
    "statusBar.debuggingForeground": "#1B1E22",
