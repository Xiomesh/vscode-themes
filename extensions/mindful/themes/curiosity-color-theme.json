    "editorGroup.border": "#524340",
    "tab.activeBackground": "#201A19",
    "tab.activeForeground": "#FAEEEB",
    "tab.activeBorderTop": "#FDB5A3",
    "tab.inactiveBackground": "#2D2523",
    "tab.inactiveForeground": "#B9A7A2",
    "tab.unfocusedActiveForeground": "#D7C2BD",
    "tab.unfocusedInactiveForeground": "#8E7E79",
    "tab.hoverBackground": "#352B28",
    "tab.border": "#524340",
    "panel.background": "#261F1E",
    "panel.border": "#524340",
    "panelTitle.activeForeground": "#FFDBD1",
