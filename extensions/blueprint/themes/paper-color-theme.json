    "list.activeSelectionForeground": "#001A42",
    "list.inactiveSelectionBackground": "#EAF2FF",
    "list.inactiveSelectionForeground": "#15181D",
    "list.hoverBackground": "#EEEEEE",
    "list.hoverForeground": "#15181D",
    "list.focusBackground": "#D8E2FF",
    "list.focusForeground": "#001A42",
    "list.highlightForeground": "#0059C7",
