    "gitDecoration.deletedResourceForeground": "#FF8A80",
    "gitDecoration.untrackedResourceForeground": "#86D4DF",
    "gitDecoration.ignoredResourceForeground": "#737A84",
    "gitDecoration.conflictingResourceForeground": "#E5C56B"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#929AA5",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "string.template"],
      "settings": {
        "foreground": "#9ED8C7"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": ["constant.numeric", "constant.language", "constant.character"],
      "settings": {
        "foreground": "#D7C8FF"
      }
    },
    {
      "name": "Keywords and storage",
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": {
        "foreground": "#82B1FF"
      }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.enum",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#B8CEFF"
      }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "entity.name.method",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#D8E2FF"
      }
    },
    {
      "name": "Variables and parameters",
      "scope": ["variable", "variable.parameter", "entity.name.variable"],
      "settings": {
        "foreground": "#E7EAEE"
      }
    },
    {
      "name": "Punctuation and delimiters",
      "scope": ["punctuation", "meta.brace", "meta.delimiter"],
      "settings": {
        "foreground": "#B7BDC6"
      }
    },
    {
      "name": "Tags and components",
      "scope": ["entity.name.tag", "support.class.component"],
      "settings": {
        "foreground": "#82B1FF"
      }
    },
    {
      "name": "Attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#9ED8C7"
      }
    },
    {
      "name": "Markdown headings and bold",
      "scope": ["markup.heading", "markup.bold"],
      "settings": {
        "foreground": "#B8CEFF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": ["markup.italic"],
      "settings": {
        "foreground": "#C1C7D0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Inline and fenced code",
      "scope": ["markup.inline.raw", "markup.fenced_code.block"],
      "settings": {
        "foreground": "#9ED8C7"
      }
    },
    {
      "name": "Invalid syntax",
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#FF8A80",
        "fontStyle": "underline"
      }
    }
  ],
  "semanticTokenColors": {
    "comment": "#929AA5",
    "string": "#9ED8C7",
    "number": "#D7C8FF",
    "keyword": "#82B1FF",
    "operator": "#B7BDC6",
    "type": "#B8CEFF",
    "class": "#B8CEFF",
    "interface": "#B8CEFF",
    "struct": "#B8CEFF",
    "enum": "#D7C8FF",
    "enumMember": "#D7C8FF",
    "function": "#D8E2FF",
    "method": "#D8E2FF",
    "property": "#C1C7D0",
    "variable": "#E7EAEE",
    "parameter": "#DCE1E7",
    "namespace": "#9ED8C7",
    "decorator": "#86D4DF",
    "regexp": "#C4B5F2"
  }
}
