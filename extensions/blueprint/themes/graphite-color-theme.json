    "terminal.foreground": "#E7EAEE",
    "terminalCursor.foreground": "#82B1FF",
    "terminal.selectionBackground": "#006EEB66",
    "terminal.ansiBlack": "#252A31",
    "terminal.ansiRed": "#FF8A80",
    "terminal.ansiGreen": "#78C6A3",
    "terminal.ansiYellow": "#E5C56B",
    "terminal.ansiBlue": "#82B1FF",
