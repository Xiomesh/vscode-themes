    "panelTitle.inactiveForeground": "#A99995",
    "editorWidget.background": "#302725",
    "editorWidget.foreground": "#FAEEEB",
    "editorWidget.border": "#6B554F",
    "editorHoverWidget.background": "#302725",
    "editorHoverWidget.foreground": "#FAEEEB",
    "editorHoverWidget.border": "#6B554F",
    "editorSuggestWidget.background": "#302725",
    "editorSuggestWidget.foreground": "#FAEEEB",
    "editorSuggestWidget.border": "#6B554F",
