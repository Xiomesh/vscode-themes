    "breadcrumb.foreground": "#606369",
    "breadcrumb.focusForeground": "#15181D",
    "breadcrumb.activeSelectionForeground": "#0059C7",
    "terminal.background": "#FFFFFF",
    "terminal.foreground": "#15181D",
    "terminalCursor.foreground": "#006EEB",
    "terminal.selectionBackground": "#AEC6FF99",
    "terminal.ansiBlack": "#15181D",
    "terminal.ansiRed": "#B42318",
    "terminal.ansiGreen": "#087A55",
    "terminal.ansiYellow": "#8A5A00",
    "terminal.ansiBlue": "#0059C7",
    "terminal.ansiMagenta": "#7C3FA3",
    "terminal.ansiCyan": "#007A86",
    "terminal.ansiWhite": "#E2E2E2",
    "terminal.ansiBrightBlack": "#606369",
    "terminal.ansiBrightRed": "#D92D20",
    "terminal.ansiBrightGreen": "#0B8F63",
    "terminal.ansiBrightYellow": "#A56D00",
    "terminal.ansiBrightBlue": "#006EEB",
    "terminal.ansiBrightMagenta": "#9552B8",
    "terminal.ansiBrightCyan": "#008D9B",
    "terminal.ansiBrightWhite": "#FFFFFF",
