    "panelTitle.inactiveForeground": "#727786",
    "editorWidget.background": "#FFFFFF",
    "editorWidget.foreground": "#15181D",
    "editorWidget.border": "#C1C6D7",
    "editorHoverWidget.background": "#FFFFFF",
    "editorHoverWidget.foreground": "#15181D",
    "editorHoverWidget.border": "#C1C6D7",
    "editorSuggestWidget.background": "#FFFFFF",
    "editorSuggestWidget.foreground": "#15181D",
    "editorSuggestWidget.border": "#C1C6D7",
    "editorSuggestWidget.selectedBackground": "#D8E2FF",
    "editorSuggestWidget.highlightForeground": "#0059C7",
    "input.background": "#FFFFFF",
    "input.foreground": "#15181D",
    "input.border": "#C1C6D7",
    "input.placeholderForeground": "#727786",
    "inputOption.activeBorder": "#006EEB",
    "inputValidation.errorBackground": "#FFF0EE",
    "inputValidation.errorBorder": "#D92D20",
