    "sideBarSectionHeader.border": "#D7C2BD",
    "statusBar.background": "#2B655D",
    "statusBar.foreground": "#FFFFFF",
    "statusBar.border": "#457E76",
    "statusBar.noFolderBackground": "#2B655D",
    "statusBar.noFolderForeground": "#FFFFFF",
    "statusBar.noFolderBorder": "#457E76",
    "statusBarItem.hoverBackground": "#457E76",
    "statusBarItem.remoteBackground": "#844E3F",
    "statusBarItem.remoteForeground": "#FFFFFF",
    "statusBar.debuggingBackground": "#844E3F",
    "statusBar.debuggingForeground": "#FFFFFF",
    "editor.background": "#FFF8F6",
