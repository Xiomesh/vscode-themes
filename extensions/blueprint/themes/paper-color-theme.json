    "editorGroupHeader.tabsBorder": "#DADDE3",
    "editorGroup.border": "#DADDE3",
    "tab.activeBackground": "#FFFFFF",
    "tab.activeForeground": "#15181D",
    "tab.activeBorderTop": "#006EEB",
    "tab.inactiveBackground": "#F3F3F4",
    "tab.inactiveForeground": "#606369",
    "tab.unfocusedActiveForeground": "#414754",
    "tab.unfocusedInactiveForeground": "#8A9099",
    "tab.hoverBackground": "#EAF2FF",
    "tab.border": "#DADDE3",
    "panel.background": "#F9F9F9",
    "panel.border": "#DADDE3",
    "panelTitle.activeForeground": "#15181D",
