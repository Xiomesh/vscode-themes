    "breadcrumb.foreground": "#B9A7A2",
    "breadcrumb.focusForeground": "#FAEEEB",
    "breadcrumb.activeSelectionForeground": "#FDB5A3",
    "terminal.background": "#201A19",
    "terminal.foreground": "#FAEEEB",
    "terminalCursor.foreground": "#FDB5A3",
    "terminal.selectionBackground": "#844E3F66",
    "terminal.ansiBlack": "#766661",
    "terminal.ansiRed": "#FFB4AB",
    "terminal.ansiGreen": "#97D2C7",
    "terminal.ansiYellow": "#F0BAAC",
    "terminal.ansiBlue": "#B7C8E8",
    "terminal.ansiMagenta": "#D9B8D6",
    "terminal.ansiCyan": "#B3EEE3",
    "terminal.ansiWhite": "#FAEEEB",
    "terminal.ansiBrightBlack": "#A99995",
    "terminal.ansiBrightRed": "#FFDAD6",
    "terminal.ansiBrightGreen": "#B3EEE3",
    "terminal.ansiBrightYellow": "#FFDBD1",
    "terminal.ansiBrightBlue": "#D6E2FF",
    "terminal.ansiBrightMagenta": "#F2D0EE",
    "terminal.ansiBrightCyan": "#D3FFF7",
    "terminal.ansiBrightWhite": "#FFFFFF",
    "gitDecoration.addedResourceForeground": "#97D2C7",
    "gitDecoration.modifiedResourceForeground": "#FDB5A3",
    "gitDecoration.deletedResourceForeground": "#FFB4AB",
    "gitDecoration.untrackedResourceForeground": "#B3EEE3",
    "gitDecoration.ignoredResourceForeground": "#85736F",
    "gitDecoration.conflictingResourceForeground": "#F0BAAC"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#A99995",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "string.template"],
      "settings": {
        "foreground": "#B3EEE3"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": ["constant.numeric", "constant.language", "constant.character"],
      "settings": {
        "foreground": "#F0BAAC"
      }
    },
    {
      "name": "Keywords and storage",
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": {
        "foreground": "#FDB5A3"
      }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.enum",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#FFDBD1"
      }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "entity.name.method",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#EBC7BC"
      }
    },
    {
      "name": "Variables and parameters",
      "scope": ["variable", "variable.parameter", "entity.name.variable"],
      "settings": {
        "foreground": "#FAEEEB"
      }
    },
    {
      "name": "Punctuation",
      "scope": ["punctuation", "meta.brace", "meta.delimiter"],
      "settings": {
        "foreground": "#D7C2BD"
      }
    },
    {
      "name": "Tags and components",
      "scope": ["entity.name.tag", "support.class.component"],
      "settings": {
        "foreground": "#FDB5A3"
      }
    },
    {
      "name": "Attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#97D2C7"
      }
    },
    {
      "name": "Markdown headings",
      "scope": ["markup.heading", "markup.bold"],
      "settings": {
        "foreground": "#FFDBD1",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown emphasis",
      "scope": ["markup.italic"],
      "settings": {
        "foreground": "#F0BAAC",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown code",
      "scope": ["markup.inline.raw", "markup.fenced_code.block"],
      "settings": {
        "foreground": "#B3EEE3"
      }
    },
    {
      "name": "Invalid syntax",
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#FFB4AB",
        "fontStyle": "underline"
      }
    }
  ],
  "semanticTokenColors": {
    "comment": "#A99995",
    "string": "#B3EEE3",
    "number": "#F0BAAC",
    "keyword": "#FDB5A3",
    "operator": "#D7C2BD",
    "type": "#FFDBD1",
    "class": "#FFDBD1",
    "interface": "#FFDBD1",
    "struct": "#FFDBD1",
    "enum": "#F0BAAC",
    "enumMember": "#F0BAAC",
    "function": "#EBC7BC",
    "method": "#EBC7BC",
    "property": "#D9CBC7",
    "variable": "#FAEEEB",
    "parameter": "#F7D1C7",
    "namespace": "#97D2C7",
    "decorator": "#97D2C7",
    "regexp": "#D9B8D6"
  }
}
