    "terminal.ansiCyan": "#86D4DF",
    "terminal.ansiWhite": "#DCE1E7",
    "terminal.ansiBrightBlack": "#737A84",
    "terminal.ansiBrightRed": "#FFB4AB",
    "terminal.ansiBrightGreen": "#A0E0BF",
    "terminal.ansiBrightYellow": "#F1D98B",
    "terminal.ansiBrightBlue": "#B8CEFF",
